#!/usr/bin/env python3
"""wa-allow: manage the WhatsApp bridge allowlist from the terminal (needs sudo).

  sudo wa-allow list
  sudo wa-allow add send 34600111222
  sudo wa-allow add read 120363012345678901@g.us
  sudo wa-allow remove send 34600111222
  sudo wa-allow remove all 34600111222

The bridge re-reads the file automatically; no restart needed.
Removing a chat from "read" also deletes what the bridge stored for it.
"""
import json, os, pwd, re, sys, tempfile

PATH = os.environ.get("WA_ALLOWLIST", "/opt/whatsapp-mcp/whatsapp-bridge/store/allowlist.json")
OWNER = "whatsapp"

def die(msg):
    print(f"wa-allow: {msg}", file=sys.stderr)
    sys.exit(1)

def normalize(s):
    s = s.strip()
    if "@" in s:
        user, server = s.split("@", 1)
        user = user.split(":", 1)[0]
        if server == "g.us" and re.fullmatch(r"[0-9-]+", user):
            return f"{user}@g.us"
        if server == "s.whatsapp.net":
            s = user
        else:
            die(f"tipo de chat no soportado: {server}")
    if re.search(r"[^0-9+ ()\-.]", s):
        die(f"número inválido: {s!r}")
    d = re.sub(r"\D", "", s)
    if not 7 <= len(d) <= 15:
        die(f"número con longitud inválida ({len(d)} dígitos); usa código de país")
    return d

def load():
    try:
        with open(PATH) as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    except json.JSONDecodeError as e:
        die(f"{PATH} no es JSON válido: {e}")
    return {"send": sorted(set(data.get("send", []))), "read": sorted(set(data.get("read", [])))}

def save(data):
    d = os.path.dirname(PATH)
    fd, tmp = tempfile.mkstemp(prefix=".allowlist-", suffix=".json", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"send": sorted(data["send"]), "read": sorted(data["read"])}, f, indent=2)
            f.write("\n")
            f.flush(); os.fsync(f.fileno())
        u = pwd.getpwnam(OWNER)
        os.chown(tmp, u.pw_uid, u.pw_gid)
        os.chmod(tmp, 0o600)
        os.replace(tmp, PATH)
    except Exception:
        os.unlink(tmp)
        raise

def main(argv):
    if os.geteuid() != 0:
        die("ejecútalo con sudo")
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return
    cmd = argv[0]
    data = load()
    if cmd == "list" and len(argv) == 1:
        for k in ("send", "read"):
            label = "Puede ENVIAR a" if k == "send" else "Puede LEER"
            print(f"{label} ({len(data[k])}):")
            for x in data[k]:
                print(f"  {x}")
        return
    if cmd in ("add", "remove") and len(argv) == 3:
        kind, target = argv[1], normalize(argv[2])
        kinds = ["send", "read"] if (cmd == "remove" and kind == "all") else [kind]
        for k in kinds:
            if k not in ("send", "read"):
                die("la lista debe ser send, read (o all al quitar)")
            s = set(data[k])
            (s.add if cmd == "add" else s.discard)(target)
            data[k] = sorted(s)
        save(data)
        print(f"OK: {cmd} {'+'.join(kinds)} {target}")
        return
    die("uso incorrecto; ejecuta: wa-allow --help")

if __name__ == "__main__":
    main(sys.argv[1:])
